    "\n",
    "def nearest(P_, S):\n",
    "    return cKDTree(S).query(P_)[0]\n",
    "\n",
    "def wq(v, ww, q):\n",
    "    o = np.argsort(v); c = np.cumsum(ww[o]) / ww.sum()\n",
    "    return float(v[o][np.searchsorted(c, q)])\n",
    "\n",
    "def cov(S, P_, wt, r=R):\n",
    "    return 100 * wt[nearest(P_, S) <= r].sum() / wt.sum()\n",
    "\n",
    "def agree(A, B_, r=1000):\n",
    "    \"\"\"Share of A's stations with a B station within r.\"\"\"\n",
    "    return 100 * (nearest(A, B_) <= r).mean()\n",
