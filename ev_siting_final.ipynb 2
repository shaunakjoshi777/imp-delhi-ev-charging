    "def km_persistence(perturb):\n",
    "    rng = np.random.default_rng(CFG[\"seed\"] + 1000); h1 = np.zeros(P); h2 = np.zeros(P); cv = []\n",
    "    for i in range(CFG[\"mc_runs\"]):\n",
    "        wp = dw_mc(dem, rng, CFG[\"mc_sigma\"], CFG[\"mc_lam\"], CFG[\"mc_conc\"], R_col=R_COL) if perturb else w\n",
    "        S = move_inside(kmeans(X, wp, P, seed=CFG[\"seed\"] + i, n_init=5)[0])\n",
    "        dd = nearest(K, S); h1 += dd <= 1000; h2 += dd <= 2000; cv.append(cov(S, X, w))\n",
    "    return h1 / CFG[\"mc_runs\"], h2 / CFG[\"mc_runs\"], np.array(cv)\n",
    "\n",
    "with Timer(\"K-means Monte Carlo (50 runs)\"):\n",
    "    kp1, kp2, kcv = km_persistence(True)\n",
    "kc1, kc2, _ = km_persistence(False)\n",
