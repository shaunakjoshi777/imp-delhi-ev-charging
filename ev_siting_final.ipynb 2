    "master = pd.read_csv(CFG[\"master\"]).set_index(\"ward_no\")\n",
    "study = gpd.read_file(CFG[\"gis\"], layer=\"study_area\").to_crs(CRS)\n",
    "study_geom = shapely.make_valid(study.union_all())\n",
    "landuse = gpd.read_file(CFG[\"gis\"], layer=\"landuse_ci\").to_crs(CRS)\n",
    "\n",
    "dem = gpd.read_file(CFG[\"demand\"], layer=\"demand_weights\").to_crs(CRS)\n",
    "pieces = gpd.read_file(CFG[\"demand\"], layer=\"demand_pieces\")\n",
    "rate = master[\"ev_4w_demand\"] / master[\"population\"]                  # EV cars + taxis per resident, by ward\n",
    "pieces[\"ev_reg\"] = pieces[\"pop_alloc\"] * pieces[\"ward_no\"].map(rate)\n",
    "dem[\"ev_reg\"] = dem[\"cell_id\"].map(pieces.groupby(\"cell_id\")[\"ev_reg\"].sum()).fillna(0).to_numpy()\n",
    "dem[\"sc_share\"] = dem[\"ward_no\"].map(master[\"sc_share\"])\n",
    "dem[\"w_team\"] = dem[\"weight\"].to_numpy(float)\n",
    "dem[\"R_ev\"] = dem[\"ev_reg\"]\n",
    "dem[\"w_ev\"] = dw_recompute(dem, R_col=\"R_ev\")          # EV registrations in place of population\n",
    "R_COL = \"R\" if CFG[\"weight\"] == \"team\" else \"R_ev\"\n",
    "X = xy(dem); POP = dem[\"pop_alloc\"].to_numpy(float); EVR = dem[\"ev_reg\"].to_numpy(float)\n",
