    "class RoadNet:\n",
    "    def __init__(self, path=CFG[\"road\"]):\n",
    "        e = gpd.read_file(path, layer=\"road_edges_v1\", columns=[\"u\", \"v\", \"oneway\", \"length_m\"], ignore_geometry=True)\n",
    "        nodes = gpd.read_file(path, layer=\"road_nodes\"); nid = pd.Index(nodes[\"id\"].to_numpy())\n",
    "        u, v = nid.get_indexer(e[\"u\"]), nid.get_indexer(e[\"v\"]); ok = (u >= 0) & (v >= 0)\n",
    "        e, u, v = e[ok], u[ok], v[ok]\n",
    "        ow = e[\"oneway\"].astype(str).str.lower(); fwd = (~ow.isin([\"-1\"])).to_numpy(); bwd = (~ow.isin([\"yes\", \"true\", \"1\"])).to_numpy()\n",
    "        L = e[\"length_m\"].to_numpy()\n",
    "        G = csr_matrix((np.r_[L[fwd], L[bwd]], (np.r_[u[fwd], v[bwd]], np.r_[v[fwd], u[bwd]])), shape=(len(nid), len(nid)))\n",
    "        _, comp = connected_components(G, directed=True, connection=\"strong\")\n",
    "        self.GT = G.T.tocsr(); self.nxy = xy(nodes); self.keep = np.flatnonzero(comp == np.bincount(comp).argmax())\n",
    "        self.tree = cKDTree(self.nxy[self.keep])\n",
    "    def snap(self, P_):\n",
    "        d, i = self.tree.query(P_); return self.keep[i], d\n",
    "    def dist_to(self, P_, S, limit=15000, batch=25):\n",
    "        pn, pdist = self.snap(P_); sn, sdist = self.snap(S); out = np.full((len(P_), len(S)), np.inf)\n",
    "        for b in range(0, len(S), batch):\n",
    "            out[:, b:b + batch] = dijkstra(self.GT, directed=True, indices=sn[b:b + batch], limit=limit)[:, pn].T\n",
    "        return out + pdist[:, None] + sdist[None, :]\n",
    "\n",
    "ROAD = RoadNet() if CFG[\"run_road\"] else None"
