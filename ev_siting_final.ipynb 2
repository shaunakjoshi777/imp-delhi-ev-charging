    "    LAYOUTS[f\"A_kmeans_{k}\"], LAYOUTS[f\"A_mclp1km_{k}\"] = Ck, X[o_]\n",
    "    for nm, S in [(\"K-means\", Ck), (\"MCLP\", X[o_])]:\n",
    "        r_ = score(S, f\"{nm} ({k})\", road=False); r_.update(method=nm, budget=k, solver_status=inf_[\"status\"] if nm == \"MCLP\" else np.nan,\n",
