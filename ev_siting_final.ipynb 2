    "\n",
    "    art = ln[ln[\"highway\"].isin(ART)].reset_index(drop=True)\n",
    "    ai = gpd.overlay(art[[\"geometry\"]], pc, how=\"intersection\", keep_geom_type=True)\n",
    "    ai[\"km\"] = ai.length / 1000\n",
    "    pieces[\"art_km\"] = pieces[\"piece_id\"].map(ai.groupby(\"piece_id\")[\"km\"].sum()).fillna(0)\n",
    "    pieces[\"art_density\"] = pieces[\"art_km\"] / pieces[\"area_km2\"]\n",
    "\n",
    "    drv = ln[ln[\"highway\"].isin(DRIVE)].geometry.values\n",
    "    xy, idx = shapely.get_coordinates(drv, return_index=True)\n",
    "    is_end = np.r_[True, idx[1:] != idx[:-1]] | np.r_[idx[1:] != idx[:-1], True]\n",
    "    nodes = pd.DataFrame({\"x\": np.round(xy[:, 0], 2), \"y\": np.round(xy[:, 1], 2), \"deg\": np.where(is_end, 1, 2)})\n",
    "    nodes = nodes.groupby([\"x\", \"y\"], as_index=False)[\"deg\"].sum()\n",
    "    inter = nodes[nodes[\"deg\"] >= 3]\n",
    "    inter = gpd.GeoDataFrame(geometry=gpd.points_from_xy(inter[\"x\"], inter[\"y\"]), crs=CRS)\n",
    "    ji = gpd.sjoin(inter, pc, predicate=\"within\")\n",
    "    pieces[\"n_intersections\"] = pieces[\"piece_id\"].map(ji.groupby(\"piece_id\").size()).fillna(0).astype(int)\n",
    "    pieces[\"int_density\"] = pieces[\"n_intersections\"] / pieces[\"area_km2\"]\n",
    "    QA[\"roads\"] = dict(arterial_km_in_area=round(pieces[\"art_km\"].sum(), 1),\n",
    "                       intersections_in_area=int(pieces[\"n_intersections\"].sum()))\n",
    "\n",
    "    cent = gpd.GeoDataFrame(pieces[[\"piece_id\"]], geometry=pieces.geometry.centroid, crs=CRS)\n",
    "    d = gpd.sjoin_nearest(cent, art[[\"geometry\"]], distance_col=\"d\").groupby(\"piece_id\")[\"d\"].min()\n",
    "    pieces[\"dist_arterial_m\"] = pieces[\"piece_id\"].map(d)\n",
    "\n",
    "    is_metro_pt = pts[\"railway\"].eq(\"station\") | pts[\"public_transport\"].eq(\"station\")\n",
    "    is_metro_pt &= pts[\"station\"].eq(\"subway\") | pts[\"subway\"].eq(\"yes\") | pts[\"network\"].str.contains(\"Metro\", na=False)\n",
    "    is_metro_pg = (mp[\"railway\"].eq(\"station\") | mp[\"public_transport\"].eq(\"station\")) & \\\n",
    "                  (mp[\"station\"].eq(\"subway\") | mp[\"subway\"].eq(\"yes\") | mp[\"network\"].str.contains(\"Metro\", na=False))\n",
    "    transit = pd.concat([\n",
    "        pts.loc[is_metro_pt, [\"geometry\"]].assign(kind=\"metro\"),\n",
    "        gpd.GeoDataFrame(geometry=mp.loc[is_metro_pg].centroid, crs=CRS).assign(kind=\"metro\"),\n",
    "        pts.loc[pts[\"amenity\"] == \"bus_station\", [\"geometry\"]].assign(kind=\"bus_terminal\"),\n",
    "        gpd.GeoDataFrame(geometry=mp.loc[mp[\"amenity\"] == \"bus_station\"].centroid, crs=CRS).assign(kind=\"bus_terminal\"),\n",
    "    ], ignore_index=True)\n",
    "    transit = gpd.GeoDataFrame(transit, geometry=\"geometry\", crs=CRS)\n",
    "    d = gpd.sjoin_nearest(cent, transit[[\"geometry\"]], distance_col=\"d\").groupby(\"piece_id\")[\"d\"].min()\n",
    "    pieces[\"dist_transit_m\"] = pieces[\"piece_id\"].map(d)\n",
    "    QA[\"transit\"] = transit.assign(in_area=transit.within(study_geom)).groupby(\"kind\")[\"in_area\"].agg([\"size\", \"sum\"]) \\\n",
    "        .rename(columns={\"size\": \"within_area_plus_buffer\", \"sum\": \"within_study_area\"}).to_dict(\"index\")\n",
    "    print(QA[\"roads\"], QA[\"transit\"])\n",
    "    g = pieces.groupby(\"ward_no\")\n",
    "    ward_res = g[\"lu_residential_m2\"].transform(\"sum\")\n",
    "    ward_area = g[\"area_m2\"].transform(\"sum\")\n",
    "    pieces[\"r_fallback\"] = (ward_res <= 0) | (ward_res < CFG[\"res_min_cover\"] * ward_area)\n",
    "    pieces[\"r_share\"] = np.where(pieces[\"r_fallback\"], pieces[\"area_m2\"] / ward_area,\n",
    "                                 pieces[\"lu_residential_m2\"] / ward_res.where(~pieces[\"r_fallback\"], 1))\n",
    "    pieces = pieces.merge(wards[[\"ward_no\", \"income_total_inr\", \"population\"]], on=\"ward_no\", how=\"left\")\n",
    "    pieces[\"R\"] = pieces[\"income_total_inr\"] * pieces[\"r_share\"]\n",
    "    pieces[\"pop_alloc\"] = pieces[\"population\"] * pieces[\"r_share\"]\n",
    "\n",
    "    mass = pieces.groupby(\"ward_no\").agg(R=(\"R\", \"sum\"), tot=(\"income_total_inr\", \"first\"),\n",
    "                                         res_km2=(\"lu_residential_m2\", lambda s: s.sum() / 1e6),\n",
    "                                         area_km2=(\"area_km2\", \"sum\"), fallback=(\"r_fallback\", \"first\"))\n",
    "    mass[\"rel_err\"] = (mass[\"R\"] / mass[\"tot\"] - 1).abs()\n",
    "    mass[\"res_cover\"] = mass[\"res_km2\"] / mass[\"area_km2\"]\n",
    "    QA[\"mass\"] = dict(max_rel_err=float(mass[\"rel_err\"].max()),\n",
    "                      total_R=float(pieces[\"R\"].sum()), total_ward=float(wards[\"income_total_inr\"].sum()),\n",
    "                      n_fallback=int(mass[\"fallback\"].sum()),\n",
    "                      fallback_wards=mass.index[mass[\"fallback\"]].tolist(),\n",
    "                      n_no_res=int((mass[\"res_km2\"] <= 0).sum()),\n",
    "                      n_res_cover_lt_10pct=int(((mass[\"res_cover\"] < 0.10) & ~mass[\"fallback\"]).sum()),\n",
    "                      median_res_cover=float(mass[\"res_cover\"].median()))\n",
    "    assert QA[\"mass\"][\"max_rel_err\"] < 1e-9\n",
    "    print({k: v for k, v in QA[\"mass\"].items() if k != \"fallback_wards\"})\n",
    "    def pct(x):\n",
    "        \"\"\"Plain percentile rank in [0, 1] (used for distances).\"\"\"\n",
    "        x = pd.Series(x)\n",
    "        return (x.rank(method=\"min\") - 1) / (len(x) - 1)\n",
    "\n",
    "\n",
    "    def pct_nz(x):\n",
    "        \"\"\"Zero-inflated features: 0 stays 0, nonzero ranked among nonzero only -> (0, 1].\"\"\"\n",
    "        x = pd.Series(x)\n",
    "        out = pd.Series(0.0, index=x.index)\n",
    "        nz = x > 0\n",
    "        out[nz] = x[nz].rank(method=\"average\") / nz.sum()\n",
    "        return out\n",
    "\n",
    "\n",
    "    def cell_points(gdf):\n",
    "        \"\"\"Dissolve pieces to cells; point = centroid, or representative point if the centroid falls outside.\"\"\"\n",
    "        cg = gdf.dissolve(\"cell_id\")[[\"geometry\"]]\n",
    "        p = cg.centroid\n",
    "        out = ~p.within(cg.geometry)\n",
    "        p[out] = cg.geometry[out].representative_point()\n",
    "        return cg, p\n",
    "\n",
    "\n",
    "    if CFG[\"dest_unit\"] == \"cell\":\n",
    "        cell_poly, cell_pt = cell_points(pieces)\n",
    "        U = pieces.groupby(\"cell_id\")[[\"area_m2\", \"area_km2\", \"art_km\", \"n_intersections\", \"lu_commercial_m2\",\n",
    "                                       \"lu_industrial_m2\"] + [f\"n_{c}\" for c in POI_CATS]].sum()\n",
    "        for c in POI_CATS:\n",
    "            U[f\"dens_{c}\"] = U[f\"n_{c}\"] / U[\"area_km2\"]\n",
    "        U[\"lu_ci_share\"] = ((U[\"lu_commercial_m2\"] + U[\"lu_industrial_m2\"]) / U[\"area_m2\"]).clip(0, 1)\n",
    "        U[\"art_density\"] = U[\"art_km\"] / U[\"area_km2\"]\n",
    "        U[\"int_density\"] = U[\"n_intersections\"] / U[\"area_km2\"]\n",
    "        cp_ = gpd.GeoDataFrame({\"cell_id\": U.index}, geometry=cell_pt.reindex(U.index).values, crs=CRS)\n",
    "        for col, tgt in [(\"dist_arterial_m\", art), (\"dist_transit_m\", transit)]:\n",
    "            U[col] = gpd.sjoin_nearest(cp_, tgt[[\"geometry\"]], distance_col=\"d\").groupby(\"cell_id\")[\"d\"].min()\n",
    "        QA[\"edge_cells_small\"] = int((U[\"area_m2\"] < 0.25 * CFG[\"cell_m\"] ** 2).sum())   # < 1/4 of a full cell\n",
    "    else:\n",
    "        U = pieces.set_index(\"piece_id\")\n",
    "\n",
    "    QA[\"zero_share\"] = {c: round(float((U[v] == 0).mean()), 3) for c, v in\n",
    "                        [*[(c, f\"dens_{c}\") for c in POI_CATS], (\"ci_land\", \"lu_ci_share\"),\n",
    "                         (\"art_density\", \"art_density\"), (\"int_density\", \"int_density\")]}\n",
    "\n",
    "    for c in POI_CATS:\n",
    "        U[f\"p_{c}\"] = pct_nz(U[f\"dens_{c}\"])\n",
    "    U[\"p_ci_land\"] = pct_nz(U[\"lu_ci_share\"])\n",
    "    U[\"p_art_density\"] = pct_nz(U[\"art_density\"])\n",
    "    U[\"p_int_density\"] = pct_nz(U[\"int_density\"])\n",
    "    U[\"p_art_prox\"] = pct(-U[\"dist_arterial_m\"])\n",
    "    U[\"p_transit_prox\"] = pct(-U[\"dist_transit_m\"])\n",
    "    key = \"cell_id\" if CFG[\"dest_unit\"] == \"cell\" else \"piece_id\"\n",
    "    _PC = [f\"p_{c}\" for c in POI_CATS] + [\"p_ci_land\", \"p_art_density\", \"p_int_density\", \"p_art_prox\", \"p_transit_prox\"]\n",
    "    for c in _PC:\n",
    "        pieces[c] = pieces[key].map(U[c]).to_numpy()      # each piece takes its unit's score\n",
    "\n",
    "    COMP = [\"poi_idx\", \"land_idx\", \"road_idx\", \"transit_idx\"]\n",
    "    pieces[\"poi_idx\"] = sum(CFG[\"theta_POI\"][c] * pieces[f\"p_{c}\"] for c in POI_CATS)\n",
    "    pieces[\"land_idx\"] = pieces[\"p_ci_land\"]\n",
    "    pieces[\"road_idx\"] = (pieces[\"p_art_density\"] + pieces[\"p_int_density\"] + pieces[\"p_art_prox\"]) / 3\n",
    "    pieces[\"transit_idx\"] = pieces[\"p_transit_prox\"]\n",
    "    th = CFG[\"theta_D\"]\n",
    "    pieces[\"D_index\"] = (th[\"poi\"] * pieces[\"poi_idx\"] + th[\"land\"] * pieces[\"land_idx\"]\n",
    "                         + th[\"road\"] * pieces[\"road_idx\"] + th[\"transit\"] * pieces[\"transit_idx\"])\n",
    "    pieces[\"D\"] = pieces[\"D_index\"] * pieces[\"area_km2\"]\n",
    "\n",
    "    # component masses: let weights be rebuilt for any lambda / theta (see demand_weights_mc.py)\n",
    "    PCOLS = [f\"p_{c}\" for c in POI_CATS] + [\"p_ci_land\", \"p_art_density\", \"p_int_density\", \"p_art_prox\", \"p_transit_prox\"]\n",
    "    for c in PCOLS:\n",
    "        pieces[\"Dm_\" + c[2:]] = pieces[c] * pieces[\"area_km2\"]\n",
    "    lam, N = CFG[\"lam\"], CFG[\"N\"]\n",
    "    pieces[\"s\"] = lam * pieces[\"R\"] / pieces[\"R\"].sum() + (1 - lam) * pieces[\"D\"] / pieces[\"D\"].sum()\n",
    "    pieces[\"weight\"] = N * pieces[\"s\"] / pieces[\"s\"].sum()\n",
    "    assert np.allclose(dw_recompute(pieces), pieces[\"weight\"])\n",
    "    pieces[[\"R\", \"D\", \"s\", \"weight\"]].describe().T\n",
    "    SUM = [\"area_m2\", \"area_km2\", \"R\", \"pop_alloc\", \"D\", \"s\", \"weight\", \"art_km\", \"n_intersections\",\n",
    "           \"lu_residential_m2\", \"lu_commercial_m2\", \"lu_industrial_m2\"] + [f\"n_{c}\" for c in POI_CATS] + \\\n",
    "          [c for c in pieces.columns if c.startswith(\"Dm_\")]\n",
    "    AWM = [\"dist_arterial_m\", \"dist_transit_m\", \"D_index\"] + COMP + PCOLS\n",
    "\n",
    "    pa = pieces.copy()\n",
    "    for c in AWM:\n",
    "        pa[c] = pa[c] * pa[\"area_m2\"]\n",
    "    agg = pa.groupby(\"cell_id\")[SUM + AWM].sum()\n",
    "    agg[AWM] = agg[AWM].div(agg[\"area_m2\"], axis=0)\n",
    "    for c in POI_CATS:\n",
    "        agg[f\"dens_{c}\"] = agg[f\"n_{c}\"] / agg[\"area_km2\"]\n",
    "    agg[\"art_density\"] = agg[\"art_km\"] / agg[\"area_km2\"]\n",
    "    agg[\"int_density\"] = agg[\"n_intersections\"] / agg[\"area_km2\"]\n",
    "    for c in [\"residential\", \"commercial\", \"industrial\"]:\n",
    "        agg[f\"lu_{c}_share\"] = agg[f\"lu_{c}_m2\"] / agg[\"area_m2\"]\n",
    "    agg[\"lu_ci_share\"] = agg[\"lu_commercial_share\"] + agg[\"lu_industrial_share\"]\n",
    "    if CFG[\"dest_unit\"] == \"cell\":                    # report the distances that were actually scored\n",
    "        agg[[\"dist_arterial_m\", \"dist_transit_m\"]] = U[[\"dist_arterial_m\", \"dist_transit_m\"]]\n",
    "    main = pieces.sort_values(\"area_m2\").groupby(\"cell_id\").tail(1).set_index(\"cell_id\")\n",
    "    agg[\"ward_no\"] = main[\"ward_no\"]\n",
    "    agg[\"n_wards\"] = pieces.groupby(\"cell_id\")[\"ward_no\"].nunique()\n",
    "    agg[\"r_fallback_any\"] = pieces.groupby(\"cell_id\")[\"r_fallback\"].any()\n",
    "\n",
    "    cell_poly = pieces.dissolve(\"cell_id\")[[\"geometry\"]]\n",
    "    pt = cell_poly.centroid\n",
    "    inside = pt.within(cell_poly.geometry)\n",
    "    pt[~inside] = cell_poly.geometry[~inside].representative_point()\n",
    "    COLS = ([\"cell_id\", \"ward_no\", \"n_wards\", \"weight\", \"R\", \"D\", \"s\", \"pop_alloc\", \"D_index\", \"area_km2\"]\n",
    "            + COMP\n",
    "            + [f\"n_{c}\" for c in POI_CATS] + [f\"dens_{c}\" for c in POI_CATS]\n",
    "            + [\"lu_residential_share\", \"lu_commercial_share\", \"lu_industrial_share\", \"lu_ci_share\",\n",
    "               \"art_km\", \"art_density\", \"n_intersections\", \"int_density\", \"dist_arterial_m\", \"dist_transit_m\"]\n",
    "            + PCOLS + [c for c in agg.columns if c.startswith(\"Dm_\")] + [\"r_fallback_any\"])\n",
    "    demand_weights = gpd.GeoDataFrame(agg.join(pt.rename(\"geometry\")).reset_index(), geometry=\"geometry\", crs=CRS)[COLS + [\"geometry\"]]\n",
    "    assert np.allclose(dw_recompute(demand_weights), demand_weights[\"weight\"])\n",
    "    assert abs(demand_weights[\"weight\"].sum() - N) < 1e-6\n",
    "    print(f\"{len(demand_weights)} demand points | weight sum {demand_weights['weight'].sum():.1f}\")\n",
    "    demand_weights.head()\n",
    "    cp = cell_poly.reset_index().merge(demand_weights[[\"cell_id\", \"R\", \"D\", \"weight\"]], on=\"cell_id\")\n",
    "    gpkg = Path(out_path)\n",
    "    if gpkg.exists():\n",
    "        gpkg.unlink()                                  # this script owns this file; rebuilt each run\n",
    "    demand_weights.to_file(gpkg, layer=\"demand_weights\", driver=\"GPKG\")\n",
    "    gpd.GeoDataFrame(pieces.drop(columns=[\"geometry\"]), geometry=pieces.geometry.centroid, crs=CRS) \\\n",
    "        .to_file(gpkg, layer=\"demand_pieces\", driver=\"GPKG\")\n",
    "    cp.to_file(gpkg, layer=\"cells_polygons\", driver=\"GPKG\")\n",
    "    for cat in [\"parking\", \"fuel\", \"substation\", \"charging\"]:\n",
    "        poi[cat].to_file(gpkg, layer=f\"feasible_{cat}\" if cat != \"charging\" else \"existing_charging_osm\", driver=\"GPKG\")\n",
    "    transit.to_file(gpkg, layer=\"transit_nodes\", driver=\"GPKG\")\n",
    "    outline.to_file(gpkg, layer=\"delhi_outline_filled\", driver=\"GPKG\")\n",
    "    print(\"Saved\", gpkg)\n",
    "    return demand_weights, QA"
   ]
  },
