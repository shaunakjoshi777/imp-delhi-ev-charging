    "         \"c_worst_sc_q_pop\": worst_q(d, \"sc_q_pop\"), \"c_worst_sc_q_cells\": worst_q(d, \"sc_q_cells\"), \"c_gini_dist_pop\": gini(d, POP + 1e-9),\n",
    "         \"d_existing_all_1km\": 100 * (nearest(E_ALL, S) <= 1000).mean(), \"d_existing_4w_1km\": 100 * (nearest(E98, S) <= 1000).mean(),\n",
    "         \"e_sites_500m_parking_fuel\": 100 * (nearest(S, REAL) <= 500).mean()}\n",
