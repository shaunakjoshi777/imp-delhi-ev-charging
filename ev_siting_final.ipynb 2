    "    wards = wards.merge(wt[[\"ward_no\", \"population\", \"income_total_inr\"]], on=\"ward_no\")\n",
    "\n",
    "    study = gpd.read_file(CFG[\"wards_path\"], layer=CFG[\"study_layer\"]).to_crs(CRS)\n",
    "    study_geom = shapely.make_valid(study.union_all())\n",
