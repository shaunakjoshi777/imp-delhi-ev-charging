    "def grid_model(size_km=3.0, threshold=0.01, origin=(679924.5228, 3142807.6633)):\n",
    "    \"\"\"One station per cell with C/I land share >= threshold. Station at cell centre, or centre of the\n",
    "    largest in-area part (rule M2). Land-use overlaps merged before measuring.\"\"\"\n",
    "    s = size_km * 1000; a = study_geom\n",
    "    minx, miny, maxx, maxy = a.bounds\n",
    "    x0 = origin[0] + np.floor((minx - origin[0]) / s) * s; y0 = origin[1] + np.floor((miny - origin[1]) / s) * s\n",
    "    cells = gpd.GeoDataFrame(geometry=[box(x, y, x + s, y + s) for x in np.arange(x0, maxx, s) for y in np.arange(y0, maxy, s)], crs=CRS)\n",
    "    cells = cells[cells.intersects(a)].reset_index(drop=True); cells[\"cell_id\"] = np.arange(len(cells))\n",
    "    inpart = cells.geometry.intersection(a)\n",
    "    ci = inpart.intersection(LU_UNION)\n",
    "    cells[\"share_ci\"] = ci.area / inpart.area\n",
    "    cells[\"station\"] = cells[\"share_ci\"] >= threshold\n",
    "    def site(g, part):\n",
    "        c = g.centroid\n",
    "        if c.within(a): return c\n",
    "        big = max(getattr(part, \"geoms\", [part]), key=lambda q: q.area); cc = big.centroid\n",
    "        return cc if cc.within(a) else big.representative_point()\n",
    "    sel = cells[cells[\"station\"]]\n",
    "    st = gpd.GeoDataFrame(sel[[\"cell_id\", \"share_ci\"]].reset_index(drop=True),\n",
    "                          geometry=[site(g, p) for g, p in zip(sel.geometry, inpart[sel.index])], crs=CRS)\n",
    "    return st, cells\n",
    "\n",
    "def kmeans(P_, wt, k, seed=CFG[\"seed\"], n_init=CFG[\"n_init\"]):\n",
    "    km = KMeans(n_clusters=k, init=\"k-means++\", n_init=n_init, max_iter=500, random_state=seed).fit(P_, sample_weight=wt)\n",
    "    return km.cluster_centers_, km.labels_, km.inertia_\n",
    "\n",
    "def move_inside(C):\n",
    "    inner = study_geom.buffer(-5)\n",
    "    return np.array([p if shapely.Point(p).within(study_geom) else np.array(nearest_points(inner, shapely.Point(p))[0].coords[0]) for p in C])\n",
    "\n",
    "def kmeans_fixed(P_, wt, fixed_xy, k_free, seed=CFG[\"seed\"], n_init=CFG[\"n_init\"], iters=200):\n",
    "    \"\"\"K-means with fixed centres (existing chargers); only k_free centres move.\"\"\"\n",
    "    rng = np.random.default_rng(seed); best = None\n",
    "    d_fix = cKDTree(fixed_xy).query(P_)[0] ** 2\n",
    "    for _ in range(n_init):\n",
    "        C = np.empty((0, 2))\n",
    "        for _ in range(k_free):\n",
    "            d = d_fix if len(C) == 0 else np.minimum(d_fix, cKDTree(C).query(P_)[0] ** 2)\n",
    "            pr = wt * d; C = np.vstack([C, P_[rng.choice(len(P_), p=pr / pr.sum())]])\n",
    "        for _ in range(iters):\n",
    "            lab = cKDTree(np.vstack([fixed_xy, C])).query(P_)[1]; newC = C.copy()\n",
    "            for j in range(k_free):\n",
    "                msk = lab == len(fixed_xy) + j\n",
    "                if msk.any(): newC[j] = np.average(P_[msk], axis=0, weights=wt[msk])\n",
    "            if np.allclose(newC, C): break\n",
    "            C = newC\n",
    "        dd = cKDTree(np.vstack([fixed_xy, C])).query(P_)[0]; inert = (wt * dd ** 2).sum()\n",
    "        if best is None or inert < best[0]: best = (inert, C)\n",
    "    return best[1]\n",
    "\n",
    "def kmeans_capacitated(P_, wt, k, cap, iters=30, n_near=15):\n",
    "    \"\"\"Balanced K-means: each centre serves at most cap weight (LP assignment).\"\"\"\n",
    "    C = kmeans(P_, wt, k, n_init=10)[0]; n = len(P_)\n",
    "    for _ in range(iters):\n",
    "        dist, idx = cKDTree(C).query(P_, k=min(n_near, k))\n",
    "        rows = np.repeat(np.arange(n), idx.shape[1]); cols = idx.ravel(); m = len(rows)\n",
    "        cost = (dist.ravel() ** 2) * wt[rows]\n",
    "        A_eq = hstack([csr_matrix((np.ones(m), (rows, np.arange(m))), shape=(n, m)), eye(n)])\n",
    "        A_ub = hstack([csr_matrix((wt[rows], (cols, np.arange(m))), shape=(k, m)), csr_matrix((k, n))])\n",
    "        r = linprog(np.r_[cost, np.full(n, cost.max() * 100)], A_ub=A_ub, b_ub=np.full(k, cap), A_eq=A_eq, b_eq=np.ones(n), bounds=(0, 1), method=\"highs\")\n",
    "        z = r.x[:m]; W = coo_matrix((z * wt[rows], (cols, rows)), shape=(k, n)).tocsr(); tot = np.asarray(W.sum(1)).ravel()\n",
    "        newC = np.where(tot[:, None] > 0, (W @ P_) / np.maximum(tot, 1e-12)[:, None], C)\n",
    "        done = np.allclose(newC, C, atol=1.0); C = newC\n",
    "        if done: break\n",
    "    return C\n",
    "\n",
    "def within(P_, S, r):\n",
    "    nb = cKDTree(S).query_ball_point(P_, r)\n",
    "    rows = np.repeat(np.arange(len(P_)), [len(a) for a in nb])\n",
    "    cols = np.concatenate([np.asarray(a, int) for a in nb]) if len(rows) else np.array([], int)\n",
    "    return csr_matrix((np.ones(len(rows)), (rows, cols)), shape=(len(P_), len(S)))\n",
    "\n",
    "def mclp(wt, A, p, A_tie=None, fixed=None, tl=CFG[\"tl_fast\"]):\n",
    "    \"\"\"Max covered weight with p new sites (HiGHS). fixed = sites forced open (not counted in p).\n",
    "    A_tie: second stage maximises coverage of A_tie at the optimal first-stage coverage.\n",
    "    Returns open indices, covered weight, solver info (status 0 = optimal, 1 = time limit).\"\"\"\n",
    "    n, J = A.shape\n",
    "    lo = np.zeros(J); new = np.ones(J)\n",
    "    if fixed is not None and len(fixed): lo[fixed] = 1; new[fixed] = 0\n",
    "    sel = hstack([csr_matrix(new.reshape(1, -1)), csr_matrix((1, n))])\n",
    "    r = milp(np.r_[np.zeros(J), -wt], constraints=[LinearConstraint(hstack([-A, eye(n)]), -np.inf, 0), LinearConstraint(sel, p, p)],\n",
    "             integrality=np.r_[np.ones(J), np.zeros(n)], bounds=Bounds(np.r_[lo, np.zeros(n)], np.ones(J + n)), options=dict(time_limit=tl))\n",
    "    best = -r.fun; info = dict(status=r.status, gap=getattr(r, \"mip_gap\", np.nan))\n",
    "    if A_tie is not None:\n",
    "        Z = csr_matrix((n, n))\n",
    "        cons = [LinearConstraint(hstack([-A, eye(n), Z]), -np.inf, 0), LinearConstraint(hstack([-A_tie, Z, eye(n)]), -np.inf, 0),\n",
    "                LinearConstraint(hstack([sel, csr_matrix((1, n))]), p, p),\n",
    "                LinearConstraint(hstack([csr_matrix((1, J)), csr_matrix(wt.reshape(1, -1)), csr_matrix((1, n))]), best * (1 - 1e-9), np.inf)]\n",
    "        r2 = milp(np.r_[np.zeros(J + n), -wt], constraints=cons, integrality=np.r_[np.ones(J), np.zeros(2 * n)],\n",
    "                  bounds=Bounds(np.r_[lo, np.zeros(2 * n)], np.ones(J + 2 * n)), options=dict(time_limit=tl))\n",
    "        if r2.status in (0, 1) and r2.x is not None: r = r2\n",
    "        info[\"tie_status\"] = r2.status\n",
    "    return np.flatnonzero(np.round(r.x[:J]) == 1), best, info\n",
    "\n",
    "def assign_problem(wt, rows, cols, J, p, obj, cap=None, tl=CFG[\"tl_fast\"], maximise=True, must=False):\n",
    "    n, m = len(wt), len(rows)\n",
    "    c = np.r_[np.zeros(J), (-obj if maximise else obj)]\n",
    "    cons = [LinearConstraint(hstack([csr_matrix((n, J)), csr_matrix((np.ones(m), (rows, np.arange(m))), shape=(n, m))]), 1 if must else 0, 1)]\n",
    "    if cap is None:\n",
    "        cons.append(LinearConstraint(hstack([csr_matrix((-np.ones(m), (np.arange(m), cols)), shape=(m, J)), eye(m)]), -np.inf, 0))\n",
    "    else:\n",
    "        cons.append(LinearConstraint(hstack([csr_matrix(-cap * eye(J)), csr_matrix((wt[rows], (cols, np.arange(m))), shape=(J, m))]), -np.inf, 0))\n",
    "    cons.append(LinearConstraint(hstack([csr_matrix(np.ones((1, J))), csr_matrix((1, m))]), p, p))\n",
    "    r = milp(c, constraints=cons, integrality=np.r_[np.ones(J), np.zeros(m)], bounds=Bounds(0, 1), options=dict(time_limit=tl))\n",
    "    return np.flatnonzero(np.round(r.x[:J]) == 1), r.x[J:], r\n",
    "\n",
    "def mclp_capacitated(wt, P_, S, p, r_, cap):\n",
    "    A = within(P_, S, r_).tocoo()\n",
    "    o, z, _ = assign_problem(wt, A.row, A.col, len(S), p, wt[A.row], cap=cap)\n",
    "    return o, (z * wt[A.row]).sum()\n",
    "\n",
    "def mclp_gradual(wt, P_, S, p, r_full=1000, r_zero=3000):\n",
    "    D = cKDTree(S).sparse_distance_matrix(cKDTree(P_), r_zero, output_type=\"coo_matrix\")\n",
    "    rows, cols = D.col, D.row; score = np.clip((r_zero - D.data) / (r_zero - r_full), 0, 1)\n",
    "    return assign_problem(wt, rows, cols, len(S), p, wt[rows] * score)[0]\n",
    "\n",
    "def pmedian(wt, P_, S, p, n_near=40, dist=None):\n",
    "    \"\"\"Minimise demand-weighted distance to the assigned open site.\"\"\"\n",
    "    if dist is None:\n",
    "        dd, idx = cKDTree(S).query(P_, k=min(n_near, len(S)))\n",
    "    else:\n",
    "        idx = np.argsort(dist, axis=1)[:, :n_near]; dd = np.take_along_axis(dist, idx, axis=1)\n",
    "    rows = np.repeat(np.arange(len(P_)), idx.shape[1]); cols = idx.ravel(); d = dd.ravel(); ok = np.isfinite(d)\n",
    "    return assign_problem(wt, rows[ok], cols[ok], len(S), p, wt[rows[ok]] * d[ok], maximise=False, must=True)[0]\n",
    "\n",
    "LU_UNION = shapely.make_valid(landuse.union_all())"
