    "kchk = []\n",
    "for kk in range(10, 151, 10):\n",
    "    Ck, lab, inert = kmeans(X, w, kk, n_init=5)\n",
    "    kchk.append({\"k\": kk, \"inertia\": inert, \"silhouette\": silhouette_score(X, lab), \"cov_pct\": cov(Ck, X, w)})\n",
    "kchk = pd.DataFrame(kchk)\n",
    "# Kneedle: normalise both axes to 0-1; the knee is where the decreasing curve sits furthest below the straight line between its ends\n",
    "kx = (kchk.k - kchk.k.min()) / (kchk.k.max() - kchk.k.min())\n",
    "ky = (kchk.inertia - kchk.inertia.min()) / (kchk.inertia.max() - kchk.inertia.min())\n",
    "gap = (1 - kx) - ky\n",
    "knee = int(kchk.k[gap.idxmax()])\n",
    "# sharpness: drop in inertia per +10 clusters just before vs just after the knee (a sharp elbow has a large ratio)\n",
    "i_ = gap.idxmax(); before = kchk.inertia[i_ - 1] - kchk.inertia[i_] if i_ > 0 else np.nan; after = kchk.inertia[i_] - kchk.inertia[i_ + 1]\n",
    "print(f\"elbow (Kneedle) at k = {knee}; inertia drop before/after the knee = {before / after:.2f}x | \"\n",
    "      f\"silhouette peak at k = {int(kchk.k[kchk.silhouette.idxmax()])} ({kchk.silhouette.max():.3f}), {kchk.silhouette.iloc[-1]:.3f} at k = 150\")\n",
    "fig, ax = plt.subplots(1, 3, figsize=(15, 3.6))\n",
