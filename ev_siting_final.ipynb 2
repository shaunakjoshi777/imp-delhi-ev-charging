    "def scenario_b(E, p_new=None):\n",
    "    _, cells3 = GRID[3]\n",
    "    Eg = gpd.GeoDataFrame(geometry=gpd.points_from_xy(E[:, 0], E[:, 1]), crs=CRS)\n",
    "    has = gpd.sjoin(cells3[cells3.station][[\"cell_id\", \"geometry\"]], Eg, predicate=\"contains\")[\"cell_id\"].unique()\n",
    "    gB = xy(GRID[3][0][~GRID[3][0].cell_id.isin(has)])\n",
    "    p_ = len(gB) if p_new is None else p_new\n",
    "    SB = np.vstack([S3, E]); fx = np.arange(len(S3), len(SB))\n",
    "    o_, _, inf_ = mclp(w, within(X, SB, R), p_, within(X, SB, CFG[\"R_tie\"]), fixed=fx)\n",
    "    mB = SB[np.setdiff1d(o_, fx)]\n",
    "    kB = kmeans_fixed(X, w, E, p_)\n",
    "    return {\"Grid B\": gB, \"K-means B\": kB, \"MCLP B\": mB}\n",
    "\n",
    "rowsB = [score(E98, \"Existing 98 only\")]\n",
    "for p_new in [None, P]:\n",
    "    sb = scenario_b(E98, p_new)\n",
    "    for n, S in sb.items():\n",
    "        if n == \"Grid B\" and p_new is not None: continue\n",
    "        LAYOUTS[f\"B_{n.split()[0].lower()}_{len(S)}new\"] = S\n",
    "        rowsB.append(score(np.vstack([E98, S]), f\"{n}: 98 + {len(S)} new\"))\n",
    "cardB = card(rowsB)\n",
