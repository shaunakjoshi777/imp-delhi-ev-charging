    "def gini(x, wts):\n",
    "    o = np.argsort(x); x, wts = x[o], wts[o]\n",
    "    cw = np.cumsum(wts) / wts.sum(); cx = np.cumsum(x * wts) / (x * wts).sum()\n",
    "    return 1 - np.sum((cx[1:] + cx[:-1]) * np.diff(cw)) - cx[0] * cw[0]\n",
    "\n",
    "def worst_q(dist, col):\n",
    "    q = dem[col]\n",
    "    return min(100 * POP[(dist <= R) & (q == g).to_numpy()].sum() / POP[(q == g).to_numpy()].sum() for g in q.cat.categories)\n",
    "\n",
    "def score(S, name, road=True):\n",
    "    d = nearest(X, S)\n",
    "    r = {\"layout\": name, \"stations\": len(S),\n",
    "         \"a_model_demand_cov\": cov(S, X, w), \"a_mean_dist_m\": np.average(d, weights=w), \"a_p95_dist_m\": wq(d, w, 0.95),\n",
