    "THETA_D = {\"poi\": 0.35, \"land\": 0.30, \"road\": 0.20, \"transit\": 0.15}\n",
    "THETA_POI = {\"office\": 0.25, \"mall\": 0.25, \"hospital\": 0.20, \"hotel\": 0.15, \"parking\": 0.15}\n",
    "LAMBDA, N_TOTAL = 0.6, 1000.0\n",
    "\n",
    "def dw_destination(df, td=THETA_D, tp=THETA_POI):\n",
    "    poi = sum(tp[k] * df[f\"Dm_{k}\"] for k in tp)\n",
    "    road = (df[\"Dm_art_density\"] + df[\"Dm_int_density\"] + df[\"Dm_art_prox\"]) / 3\n",
    "    return td[\"poi\"] * poi + td[\"land\"] * df[\"Dm_ci_land\"] + td[\"road\"] * road + td[\"transit\"] * df[\"Dm_transit_prox\"]\n",
    "\n",
    "def dw_recompute(df, lam=LAMBDA, td=THETA_D, tp=THETA_POI, N=N_TOTAL, R_col=\"R\"):\n",
    "    Rv = df[R_col].to_numpy(float); Dv = dw_destination(df, td, tp).to_numpy(float)\n",
    "    s = lam * Rv / Rv.sum() + (1 - lam) * Dv / Dv.sum()\n",
    "    return N * s / s.sum()\n",
    "\n",
    "def dw_mc(df, rng, sigma=0.30, lam_range=(0.3, 0.8), conc=50.0, R_col=\"R\"):\n",
    "    \"\"\"One Monte Carlo draw: lambda ~ U, theta ~ Dirichlet, lognormal noise.\"\"\"\n",
    "    lam = rng.uniform(*lam_range)\n",
    "    kd, kp = list(THETA_D), list(THETA_POI)\n",
    "    td = dict(zip(kd, rng.dirichlet(conc * np.array([THETA_D[k] for k in kd]))))\n",
    "    tp = dict(zip(kp, rng.dirichlet(conc * np.array([THETA_POI[k] for k in kp]))))\n",
    "    w_ = dw_recompute(df, lam, td, tp, R_col=R_col) * rng.lognormal(0, sigma, len(df))\n",
    "    return N_TOTAL * w_ / w_.sum()"
   ]
